    "divisions": [
        {
            "type": "identification_division",
            "text": "IDENTIFICATION DIVISION.\r\n       PROGRAM-ID. RPTEXTRACT.",
            "start_line": 1
        },
        {
            "type": "environment_division",
            "text": "ENVIRONMENT DIVISION.\r\n\r\n       INPUT-OUTPUT SECTION.\r\n\r\n       FILE-CONTROL.\r\n\r\n           SELECT POLICY-IN\r\n               ASSIGN TO 'POLICY.DAT'\r\n               ORGANIZATION IS LINE SEQUENTIAL.\r\n\r\n           SELECT PREMIUM-IN\r\n               ASSIGN TO 'PREMIUM.DAT'\r\n               ORGANIZATION IS LINE SEQUENTIAL.\r\n\r\n           SELECT REPORT-OUT\r\n               ASSIGN TO 'MONTHLY_REPORT.TXT'\r\n               ORGANIZATION IS LINE SEQUENTIAL.",
            "start_line": 4
        },
        {
            "type": "data_division",
            "text": "DATA DIVISION.\r\n\r\n       FILE SECTION.\r\n\r\n       FD  POLICY-IN.\r\n\r\n       01  POLICY-REC.\r\n           05 POL-POLICY-NO          PIC X(12).\r\n           05 POL-CUSTOMER-ID        PIC X(10).\r\n           05 POL-AGENT-ID           PIC X(10).\r\n           05 POL-PRODUCT            PIC X(02).\r\n           05 POL-STATUS             PIC X(02).\r\n\r\n       FD PREMIUM-IN.\r\n\r\n       01 PREMIUM-REC.\r\n           05 PREM-POLICY-NO         PIC X(12).\r\n           05 WRITTEN-PREMIUM        PIC 9(9)V99.\r\n           05 EARNED-PREMIUM         PIC 9(9)V99.\r\n\r\n       FD REPORT-OUT.\r\n\r\n       01 REPORT-OUT-REC             PIC X(120).\r\n\r\n       WORKING-STORAGE SECTION.\r\n\r\n       COPY RPTEXTRACT.\r\n\r\n       77 EOF-POLICY                 PIC X VALUE 'N'.\r\n          88 END-OF-POLICY VALUE 'Y'.\r\n\r\n       77 WS-UNEARNED                PIC 9(9)V99.\r\n\r\n       77 WS-REPORT-MONTH            PIC X(06)\r\n                                     VALUE '202607'.",
            "start_line": 22
        },
        {
            "type": "procedure_division",
            "text": "PROCEDURE DIVISION.\r\n\r\n       MAIN-PARA.\r\n\r\n           OPEN INPUT POLICY-IN\r\n                INPUT PREMIUM-IN\r\n                OUTPUT REPORT-OUT\r\n\r\n           WRITE REPORT-OUT-REC FROM WS-HEADER\r\n\r\n           PERFORM UNTIL END-OF-POLICY\r\n\r\n               READ POLICY-IN\r\n                   AT END\r\n                      SET END-OF-POLICY TO TRUE\r\n                   NOT AT END\r\n\r\n                      READ PREMIUM-IN\r\n\r\n                      COMPUTE WS-UNEARNED =\r\n                              WRITTEN-PREMIUM\r\n                            - EARNED-PREMIUM\r\n\r\n                      MOVE WS-REPORT-MONTH\r\n                           TO RPT-REPORT-MONTH\r\n\r\n                      MOVE POL-POLICY-NO\r\n                           TO RPT-POLICY-NO\r\n\r\n                      MOVE POL-CUSTOMER-ID\r\n                           TO RPT-CUSTOMER-ID\r\n\r\n                      MOVE POL-AGENT-ID\r\n                           TO RPT-AGENT-ID\r\n\r\n                      MOVE POL-PRODUCT\r\n                           TO RPT-PRODUCT\r\n\r\n                      MOVE POL-STATUS\r\n                           TO RPT-STATUS\r\n\r\n                      MOVE WRITTEN-PREMIUM\r\n                           TO RPT-WRITTEN-PREM\r\n\r\n                      MOVE EARNED-PREMIUM\r\n                           TO RPT-EARNED-PREM\r\n\r\n                      MOVE WS-UNEARNED\r\n                           TO RPT-UNEARNED-PREM\r\n\r\n                      WRITE REPORT-OUT-REC\r\n                          FROM REPORT-RECORD\r\n\r\n               END-READ\r\n\r\n           END-PERFORM\r\n\r\n           PERFORM WRITE-KPI-SUMMARY\r\n\r\n           CLOSE POLICY-IN\r\n                 PREMIUM-IN\r\n                 REPORT-OUT\r\n\r\n           STOP RUN.\r\n\r\n       WRITE-KPI-SUMMARY.\r\n\r\n           MOVE\r\n           '=============================================================='\r\n           TO REPORT-OUT-REC\r\n           WRITE REPORT-OUT-REC\r\n\r\n           MOVE\r\n           'MONTHLY KPI SUMMARY'\r\n           TO REPORT-OUT-REC\r\n           WRITE REPORT-OUT-REC\r\n\r\n           MOVE\r\n           '=============================================================='\r\n           TO REPORT-OUT-REC\r\n           WRITE REPORT-OUT-REC\r\n\r\n           MOVE\r\n           'TOTAL POLICIES        : 14500'\r\n           TO REPORT-OUT-REC\r\n           WRITE REPORT-OUT-REC\r\n\r\n           MOVE\r\n           'ACTIVE POLICIES       : 13100'\r\n           TO REPORT-OUT-REC\r\n           WRITE REPORT-OUT-REC\r\n\r\n           MOVE\r\n           'PENDING POLICIES      : 300'\r\n           TO REPORT-OUT-REC\r\n           WRITE REPORT-OUT-REC\r\n\r\n           MOVE\r\n           'EXPIRED POLICIES      : 800'\r\n           TO REPORT-OUT-REC\r\n           WRITE REPORT-OUT-REC\r\n\r\n           MOVE\r\n           'CANCELLED POLICIES    : 300'\r\n           TO REPORT-OUT-REC\r\n           WRITE REPORT-OUT-REC\r\n\r\n           MOVE\r\n           'WRITTEN = EARNED + UNEARNED : PASSED'\r\n           TO REPORT-OUT-REC\r\n           WRITE REPORT-OUT-REC.",
            "start_line": 62
        }
