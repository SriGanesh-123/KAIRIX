    "operations": {
        "perform": [
            "PERFORM 1000-INITIALIZE PERFORM UNTIL WS-EOF = 'Y' PERFORM 2000-READ-INPUT IF WS-EOF NOT = 'Y' PERFORM 3000-VALIDATE PERFORM 4000-WRITE-VSAM END-IF END-PERFORM PERFORM 9000-CLOSE-FILES STOP RUN."
        ],
        "read": [
            "READ INPUT *============================================================* 2000-READ-INPUT.",
            "READ POLICY-IN AT END MOVE 'Y' TO WS-EOF NOT AT END ADD 1 TO WS-READ-COUNT END-READ."
        ],
        "write": [
            "WRITE VSAM RECORD *============================================================* 4000-WRITE-VSAM.",
            "WRITE POLICY-MASTER-RECORD INVALID KEY DISPLAY 'DUPLICATE POLICY : ' POLICY-NUMBER ADD 1 TO WS-ERROR-COUNT NOT INVALID KEY ADD 1 TO WS-WRITE-COUNT END-WRITE."
        ],
        "move": [
            "MOVE 'Y' TO WS-EOF NOT AT END ADD 1 TO WS-READ-COUNT END-READ.",
            "Move Input Record to VSAM Record MOVE PI-POLICY-NUMBER TO POLICY-NUMBER MOVE PI-CUSTOMER-ID TO CUSTOMER-ID MOVE PI-AGENT-ID TO AGENT-ID MOVE PI-PRODUCT-CODE TO PRODUCT-CODE MOVE PI-POLICY-TYPE TO POLICY-TYPE MOVE PI-EFFECTIVE-DATE TO EFFECTIVE-DATE MOVE PI-EXPIRATION-DATE TO EXPIRATION-DATE MOVE PI-CURRENT-STATUS TO CURRENT-STATUS MOVE PI-PAYMENT-FREQUENCY TO PAYMENT-FREQUENCY MOVE PI-POLICY-TERM TO POLICY-TERM MOVE PI-WRITTEN-PREMIUM TO WRITTEN-PREMIUM MOVE PI-EARNED-PREMIUM TO EARNED-PREMIUM MOVE PI-RENEWAL-DATE TO RENEWAL-DATE."
        ],
        "open": [
            "OPEN INPUT POLICY-IN IF WS-IN-STATUS NOT = \"00\" DISPLAY 'ERROR OPENING INPUT FILE' DISPLAY 'STATUS = ' WS-IN-STATUS STOP RUN END-IF OPEN OUTPUT POLICY-MASTER IF WS-VSAM-STATUS NOT = \"00\" DISPLAY 'ERROR OPENING VSAM FILE' DISPLAY 'STATUS = ' WS-VSAM-STATUS STOP RUN END-IF."
        ],
        "close": [
            "CLOSE FILES *============================================================* 9000-CLOSE-FILES.",
            "CLOSE POLICY-IN.",
            "CLOSE POLICY-MASTER."
        ],
        "display": [
            "DISPLAY 'POLLOAD STARTED'.",
            "DISPLAY 'ERROR OPENING INPUT FILE' DISPLAY 'STATUS = ' WS-IN-STATUS STOP RUN END-IF OPEN OUTPUT POLICY-MASTER IF WS-VSAM-STATUS NOT = \"00\" DISPLAY 'ERROR OPENING VSAM FILE' DISPLAY 'STATUS = ' WS-VSAM-STATUS STOP RUN END-IF.",
            "DISPLAY 'INVALID POLICY NUMBER' ADD 1 TO WS-ERROR-COUNT GO TO 3000-EXIT END-IF.",
            "DISPLAY 'DUPLICATE POLICY : ' POLICY-NUMBER ADD 1 TO WS-ERROR-COUNT NOT INVALID KEY ADD 1 TO WS-WRITE-COUNT END-WRITE.",
            "DISPLAY '-------------------------------------'.",
            "DISPLAY 'TOTAL RECORDS READ : ' WS-READ-COUNT.",
            "DISPLAY 'TOTAL RECORDS WRITTEN : ' WS-WRITE-COUNT.",
            "DISPLAY 'TOTAL ERRORS : ' WS-ERROR-COUNT.",
            "DISPLAY 'POLLOAD COMPLETED'."
        ],
        "if": [
            "IF WS-EOF NOT = 'Y' PERFORM 3000-VALIDATE PERFORM 4000-WRITE-VSAM END-IF END-PERFORM PERFORM 9000-CLOSE-FILES STOP RUN.",
            "IF WS-IN-STATUS NOT = \"00\" DISPLAY 'ERROR OPENING INPUT FILE' DISPLAY 'STATUS = ' WS-IN-STATUS STOP RUN END-IF OPEN OUTPUT POLICY-MASTER IF WS-VSAM-STATUS NOT = \"00\" DISPLAY 'ERROR OPENING VSAM FILE' DISPLAY 'STATUS = ' WS-VSAM-STATUS STOP RUN END-IF.",
            "IF PI-POLICY-NUMBER = SPACES DISPLAY 'INVALID POLICY NUMBER' ADD 1 TO WS-ERROR-COUNT GO TO 3000-EXIT END-IF."
        ],
        "goto": [
            "GO TO 3000-EXIT END-IF."
        ],
        "add": [
            "ADD 1 TO WS-READ-COUNT END-READ.",
            "ADD 1 TO WS-ERROR-COUNT GO TO 3000-EXIT END-IF.",
            "ADD 1 TO WS-ERROR-COUNT NOT INVALID KEY ADD 1 TO WS-WRITE-COUNT END-WRITE."
        ]
    },
